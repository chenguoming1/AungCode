# Copy to .env and fill in. .env is gitignored; this template is not.
# Real environment variables override anything set here.

# The active provider normally comes from `provider` in agent/config.toml.
# Uncomment only to override it for this machine — this line wins over the file.
# AGENT_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# GitHub Models: a PAT with the `models:read` scope.
GITHUB_TOKEN=
