# Copy to .env and fill in. .env is gitignored; this template is not.
# Real environment variables override anything set here.

# Which [providers.*] section of agent/config.toml to use.
AGENT_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# GitHub Models: a PAT with the `models:read` scope.
GITHUB_TOKEN=
